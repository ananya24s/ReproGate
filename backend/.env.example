# ReproGate backend configuration.
# Copy to `.env` and fill in the secrets. Never commit the resulting file.

# -- Application ------------------------------------------------------------
APP_NAME=ReproGate
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1

# -- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -- Logging ----------------------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: json (production) | console (local development)
LOG_LEVEL=INFO
LOG_FORMAT=console

# -- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# -- Persistence ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://reprogate:reprogate@localhost:5432/reprogate
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# -- GitHub -----------------------------------------------------------------
GITHUB_API_URL=https://api.github.com
# Fine-grained personal access token with read access to the target repositories.
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT_SECONDS=30

# -- LLM --------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_REQUEST_TIMEOUT_SECONDS=120
OPENAI_API_KEY=

# -- Sandbox ----------------------------------------------------------------
# Leave DOCKER_HOST empty to use the local Docker socket.
DOCKER_HOST=
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_ENABLED=false
SANDBOX_WORKSPACE_ROOT=/tmp/reprogate
