# ReproGate frontend configuration.
# Copy to `.env` for local development. Vite inlines these values into the
# bundle at build time — never put secrets here.

# Origin of the ReproGate backend. Required.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Version prefix of the backend REST API.
VITE_API_VERSION_PREFIX=/api/v1

# How often in-progress verification runs are re-polled, in milliseconds.
VITE_RUN_POLL_INTERVAL_MS=2000
